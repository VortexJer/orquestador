# Copiar a .env y ajustar. Ver app/config.py para el detalle de cada variable.

# mock: sin GPU, sin pesos reales (default, usar mientras no haya GPU alquilada)
# http: habla con un servidor OpenAI-compatible real (vLLM / llama.cpp server / Ollama)
INFERENCE_MODE=mock

# Solo importan si INFERENCE_MODE=http
INFERENCE_BASE_URL=http://localhost:8001/v1
ROUTER_BASE_URL=http://localhost:8000/v1
INFERENCE_API_KEY=

# heuristic (default, fase 1) | llm (requiere router real via GPU, ver eval/scripts/eval_router.py)
ROUTER_IMPL=heuristic

# embedded: Qdrant embebido en un archivo local, sin Docker (default, desarrollo)
# remote: Qdrant como servicio propio (docker-compose), para el servidor real
QDRANT_MODE=embedded
QDRANT_PATH=./qdrant_local_data
QDRANT_URL=http://localhost:6333

# API keys validas separadas por coma. Cambiar antes de exponer el servicio.
API_KEYS=dev-local-key

# --- Proveedores de modelos para groq_agent/ (la terminal de pruebas) ---
#
# NO edites esto a mano: corré 'orquestador --config' (o -cfg) y te pide
# solo las que falten, una a una, con el enlace de registro de cada una.
# Despues 'orquestador --check-providers' verifica cuales responden.
#
# Todas son GRATIS y sin tarjeta. Cada proveedor admite varias keys de
# banquillo: NVIDIA_API_KEY, NVIDIA_API_KEY_2, ... (dos cuentas gratis son
# el doble de cuota). Tambien se puede poner varias separadas por coma.
#
# El objetivo del diseño es NO llegar nunca a NVIDIA: es la unica sin tope
# diario, o sea la red de seguridad, y una red que se usa a diario deja de
# serlo. Por eso conviene tener varias de las "recomendadas" puestas.

# Red de seguridad (~40 RPM, sin tope diario) - build.nvidia.com
NVIDIA_API_KEY=

# Recomendadas: son las que evitan gastar NVIDIA
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Cobertura extra (cuanto mas, menos se toca NVIDIA)
CODESTRAL_API_KEY=
SILICONFLOW_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=

# Solo para eval_router.py como ground truth (modelos frontera: tamaño
# equivocado para probar el catalogo, no se usa en los especialistas)
GITHUB_MODELS_API_KEY=

# Forzar UN proveedor concreto en vez de la escalera. Vacio = escalera con
# failover (lo normal). Util cuando haya GPU propia: LLM_PROVIDER + un
# base_url de vLLM.
LLM_PROVIDER=

# Opcionales, para que web-builder-specialist pueda buscar fotos
# royalty-free reales en vez de quedarse sin imagenes (search_images).
# Gratis en pexels.com/api y unsplash.com/developers.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Opcionales, buscadores web para IA (search_web) - refuerzan la cascada
# gratuita DuckDuckGo/SearXNG cuando bloquea. Todas GRATIS y SIN tarjeta.
# Ollama: key de cuenta en ollama.com/settings/keys
# Tavily: 1000/mes en app.tavily.com
# Jina: jina.ai/reader
OLLAMA_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=

# Brave Search: opcional, pero pide TARJETA para el free tier (por eso va la
# ultima). https://brave.com/search/api/
BRAVE_API_KEY=

# Referencia de costo GPU serverless (RunPod L4 on-demand, ver doc de arquitectura)
GPU_COST_USD_PER_SECOND=0.00018

TOOL_SANDBOX_TIMEOUT_S=20

# Umbral de aceptacion para eval/scripts/eval_router.py
ROUTER_EVAL_MIN_ACCURACY=0.85
